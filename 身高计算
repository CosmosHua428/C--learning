#include <stdio.h>
int main()
{
    printf("请输入身高的英尺和英寸，"
        "如输入\"5 7\"表示5英尺7英寸：");
    
    double foot;  //使用double函数将变量定义为浮点数，以便浮点数的计算。
    double inch;

    scanf("%lf %lf",&foot,&inch);  //整数用%d，浮点数用%lf。

    printf("身高是%f米。\n",((foot + inch / 12)*0.3048));  //不要跟scanf的弄混了。

    return 0;

}
